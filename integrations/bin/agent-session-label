#!/usr/bin/env -S python3 -I
"""Label this herdr-app terminal with the coding agent's session id (agent.session) and program
(agent.app), for the agents-ids mod.

Usage: agent-session-label <session-id> [agent-pid|-] [app]
       agent-session-label < hook.json        (JSON on stdin with "session_id": Claude Code, Codex hooks)

Labels only when the agent is (a direct child of) the terminal's foreground job leader, so an agent
started by another agent (one agent running `claude -p`, a script running codex) never overwrites the
visible agent's label. agent.app is that leader's process name (claude, codex, pi, pig, opencode)
unless given. Does nothing outside herdr-app (no HC_TERMINAL_ID). Reads /proc on Linux, `ps`
elsewhere (macOS). Never fails loudly: a hook must not break the agent.
"""
import json
import os
import subprocess
import sys

SHELLS = {"sh", "bash", "dash", "zsh", "fish", "env"}


def stat(pid: int) -> tuple[str, int, int, int]:
    """(comm, ppid, pgrp, tpgid) of a process."""
    if os.path.exists(f"/proc/{pid}/stat"):
        raw = open(f"/proc/{pid}/stat").read()
        comm = raw[raw.index("(") + 1:raw.rindex(")")]
        f = raw[raw.rindex(")") + 2:].split()
        return comm, int(f[1]), int(f[2]), int(f[5])
    out = subprocess.run(["ps", "-o", "ppid=,pgid=,tpgid=,comm=", "-p", str(pid)],
                         capture_output=True, text=True, timeout=3, check=True).stdout.split(None, 3)
    return os.path.basename(out[3].strip()), int(out[0]), int(out[1]), int(out[2])


def agent_pid(start: int) -> int:
    """The nearest ancestor (or start itself) that isn't a shell: the agent that ran this hook."""
    pid = start
    while pid > 1:
        comm, ppid, _, _ = stat(pid)
        if comm.lstrip("-") not in SHELLS:
            return pid
        pid = ppid
    return 0


def foreground_leader(pid: int) -> bool:
    _, _, pgrp, tpgid = stat(pid)
    return pid == pgrp == tpgid


def leader(pid: int) -> int:
    """The terminal's foreground job leader if pid is it or its direct child, else 0. Codex and OpenCode
    run hooks/plugins in a child of the TUI process, PiG in a node child of its launcher. One level only,
    so an agent another agent started through a shell (Hermes -> bash -> claude) stays unlabelled."""
    if foreground_leader(pid):
        return pid
    parent = stat(pid)[1]
    return parent if parent > 1 and foreground_leader(parent) else 0


def main(argv: list[str]) -> int:
    term = os.environ.get("HC_TERMINAL_ID", "").strip()
    if not term:
        return 0
    sid = argv[1] if len(argv) > 1 else ""
    if not sid and not sys.stdin.isatty():
        try:
            sid = str(json.load(sys.stdin).get("session_id") or "")
        except ValueError:
            sid = ""
    pid = int(argv[2]) if len(argv) > 2 and argv[2] not in ("", "-") else agent_pid(os.getppid())
    front = leader(pid) if sid and pid else 0
    if not front:
        return 0
    app = argv[3] if len(argv) > 3 else stat(front)[0]
    subprocess.run(["hc", "label", term, f"agent.session={sid}", f"agent.app={app}"], timeout=3,
                   stdout=subprocess.DEVNULL, stderr=subprocess.DEVNULL, check=False)
    return 0


if __name__ == "__main__":
    try:
        sys.exit(main(sys.argv))
    except Exception:
        sys.exit(0)
